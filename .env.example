# Copy to .env.local and fill in. Never commit .env.local.
# Only ANTHROPIC_API_KEY is needed to run the demo locally with the simulator.
# With DEMO_MODE=1 nothing at all is needed (see "Demo mode" below).

# ── Demo mode (public live demo / Codespaces) ───────────────────────
# 1 = no secrets, no spend: the agent uses the offline model (Claude is never
# called, even if a key is set), data lives in memory seeded from the fictional
# seed at startup, and the WhatsApp webhook and every outbound send are off.
# The simulator gets a per-IP rate limit and a message length cap.
DEMO_MODE=
# Protects /api/demo/reset (send it as `x-demo-reset-token` or `Authorization: Bearer`).
# Generate one with: openssl rand -hex 24
DEMO_RESET_TOKEN=
# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron calls: set it on Vercel
# so the nightly cron in vercel.json can reset the demo (it may equal DEMO_RESET_TOKEN).
CRON_SECRET=

# ── AI ──────────────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com). Required for the agent.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5.
CLAUDE_MODEL=

# ── Database (optional locally) ─────────────────────────────────────
# Without these the app stores everything in data/store.json.
# The service role key bypasses RLS: server-side only, never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (optional; the /simulador page works without it) ──
# Meta app → WhatsApp → API Setup: access token and phone number id.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in Meta's webhook configuration.
# Generate one with: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret. When set, every webhook POST must
# carry a valid X-Hub-Signature-256 or it is rejected with 401. Set it in production.
WHATSAPP_APP_SECRET=

# ── Evals ───────────────────────────────────────────────────────────
# Minimum pass rate for `npm run evals` (default 1.0 offline, 0.8 live).
EVAL_MIN_PASS_RATE=
